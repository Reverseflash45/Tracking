<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/judul_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rutinitas"
        android:textColor="@color/widget_aksen"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Buka app sekali supaya widget ini terisi."
        android:textColor="@color/widget_redup"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/baris0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/judul0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_teks"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/label0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_redup"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/selesai0"
            android:layout_width="28dp"
            android:layout_height="22dp"
            android:paddingStart="6dp"
            android:contentDescription="Tandai sudah"
            android:src="@drawable/ic_widget_selesai"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/baris1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
